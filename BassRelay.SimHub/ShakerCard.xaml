<UserControl x:Class="BassRelay.UI.ShakerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             Margin="0,0,0,6" HorizontalContentAlignment="Stretch"
             Foreground="{DynamicResource TextBrush}" ToolTipService.ShowOnDisabled="True">
    <styles:SHSubSection Title="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
        <StackPanel>
            <Grid>
                <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="DeviceChanged" AutomationProperties.Name="{DynamicResource ShakerDevice}"
                          MinHeight="30" ToolTip="{DynamicResource RemoveShakerHelp}" />
                <TextBlock x:Name="DevicePlaceholder" Margin="8,0,28,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Opacity="0.8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=DeviceBox}" Value="-1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="ProcessingControls">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="105" />
                    </Grid.ColumnDefinitions>
                    <StackPanel ToolTip="{DynamicResource ShakerStrengthHelp}">
                        <TextBlock Text="{DynamicResource VibrationStrength}" Margin="0,0,0,3" />
                        <Grid MinHeight="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="GainSlider" Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="10"
                                    VerticalAlignment="Center" Margin="0,0,8,0" ValueChanged="GainValueChanged"
                                    PreviewMouseLeftButtonUp="GainMouseReleased" KeyUp="GainKeyReleased" LostKeyboardFocus="GainLostFocus"
                                    AutomationProperties.Name="{DynamicResource VibrationPercent}" />
                            <TextBlock x:Name="GainValueLabel" Grid.Column="1" Text="100 %"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource LowCut}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <TextBox x:Name="LowCutBox" LostKeyboardFocus="NumericLostFocus" KeyDown="NumericKeyDown"
                                 PreviewTextInput="FrequencyTextInput" DataObject.Pasting="FrequencyPaste"
                                 ToolTip="{DynamicResource FrequencyHelp}" ToolTipService.ShowOnDisabled="True"
                                 AutomationProperties.Name="{DynamicResource LowCut}" MaxLength="8" MinHeight="30" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{DynamicResource HighCut}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <TextBox x:Name="HighCutBox" LostKeyboardFocus="NumericLostFocus" KeyDown="NumericKeyDown"
                                 PreviewTextInput="FrequencyTextInput" DataObject.Pasting="FrequencyPaste"
                                 ToolTip="{DynamicResource FrequencyHelp}" ToolTipService.ShowOnDisabled="True"
                                 AutomationProperties.Name="{DynamicResource HighCut}" MaxLength="8" MinHeight="30" />
                    </StackPanel>
                </Grid>
                <Border x:Name="WarningIndicator" Grid.Column="1" Width="20" Height="20"
                        Margin="10,27,0,0" VerticalAlignment="Top" CornerRadius="10"
                        BorderBrush="#E56D6D" BorderThickness="1.5" Background="Transparent"
                        Visibility="Collapsed" ToolTipService.InitialShowDelay="200"
                        ToolTipService.ShowDuration="15000" AutomationProperties.Name="{DynamicResource ShakerUnavailable}">
                    <TextBlock Text="!" Foreground="#E56D6D" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <TextBlock x:Name="ValidationLabel" Foreground="#E56D6D" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
    </styles:SHSubSection>
</UserControl>
