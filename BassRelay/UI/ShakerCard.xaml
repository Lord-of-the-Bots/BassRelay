<UserControl x:Class="BassRelay.UI.ShakerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,12" HorizontalContentAlignment="Stretch"
             ToolTipService.ShowOnDisabled="True">
    <StackPanel>
        <Grid>
            <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="DeviceChanged" AutomationProperties.Name="{DynamicResource ShakerDevice}"
                      MinHeight="32" Height="32" />
            <TextBlock x:Name="DevicePlaceholder"
                       Margin="8,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=DeviceBox}" Value="-1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <Grid Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <Grid x:Name="ProcessingControls">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Grid Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="GainSlider" Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="10"
                            VerticalAlignment="Center" Margin="0,0,5,0" ValueChanged="GainValueChanged"
                            PreviewMouseLeftButtonUp="GainMouseReleased" KeyUp="GainKeyReleased" LostKeyboardFocus="GainLostFocus"
                            AutomationProperties.Name="{DynamicResource VibrationPercent}" />
                    <TextBlock x:Name="GainValueLabel" Grid.Column="1" Text="100 %" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{DynamicResource VibrationStrength}" Foreground="#667383" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
            <Grid Grid.Column="2">
              <Grid x:Name="CommonFrequencyControls">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBox x:Name="LowCutBox" LostKeyboardFocus="NumericLostFocus" KeyDown="NumericKeyDown"
                         PreviewTextInput="FrequencyTextInput" DataObject.Pasting="FrequencyPaste"
                         ToolTip="{DynamicResource FrequencyHelp}" ToolTipService.ShowOnDisabled="True"
                         AutomationProperties.Name="{DynamicResource LowCut}" MaxLength="8" MinHeight="30" Height="30" Padding="7,4" />
                <TextBlock Text="{DynamicResource LowCut}" Foreground="#667383" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBox x:Name="HighCutBox" LostKeyboardFocus="NumericLostFocus" KeyDown="NumericKeyDown"
                         PreviewTextInput="FrequencyTextInput" DataObject.Pasting="FrequencyPaste"
                         ToolTip="{DynamicResource FrequencyHelp}" ToolTipService.ShowOnDisabled="True"
                         AutomationProperties.Name="{DynamicResource HighCut}" MaxLength="8" MinHeight="30" Height="30" Padding="7,4" />
                <TextBlock Text="{DynamicResource HighCut}" Foreground="#667383" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
              </Grid>
              <Button x:Name="OpenMapperButton" Content="{DynamicResource OpenChannelMapper}"
                      Click="OpenMapperClicked" Height="30" VerticalAlignment="Top" Visibility="Collapsed" />
            </Grid>
            <CheckBox x:Name="CustomMappingBox" Grid.Column="4" VerticalAlignment="Top" Margin="0,6,0,0"
                      Checked="CustomMappingChanged" Unchecked="CustomMappingChanged"
                      ToolTip="{DynamicResource CustomChannelMappingHelp}" ToolTipService.ShowOnDisabled="True"
                      AutomationProperties.Name="{DynamicResource CustomChannelMapping}">
                <TextBlock Text="{DynamicResource CustomChannelMapping}" MaxWidth="100" TextWrapping="Wrap" FontSize="11" />
            </CheckBox>
        </Grid>
            <Border x:Name="WarningIndicator" Grid.Column="1" Width="18" Height="18"
                    Margin="8,6,0,0" VerticalAlignment="Top" CornerRadius="9"
                    BorderBrush="#C8323D" BorderThickness="1.5" Background="Transparent"
                    Visibility="Collapsed" ToolTipService.InitialShowDelay="200"
                    ToolTipService.ShowDuration="15000" AutomationProperties.Name="{DynamicResource ShakerUnavailable}">
                <TextBlock Text="!" Foreground="#C8323D" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
            </Border>
        </Grid>
        <TextBlock x:Name="ValidationLabel" Foreground="#B63333" FontSize="11" TextWrapping="Wrap"
                   Margin="0,7,0,0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
