<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BassRelay</AssemblyName>
    <RootNamespace>BassRelay</RootNamespace>
    <Version>1.4.1</Version>
    <!-- WPF owns DPI awareness; Windows Forms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/BassRelay.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/BassRelay.ico" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <ProjectReference Include="../BassRelay.Audio/BassRelay.Audio.csproj" />
    <Compile Remove="Audio/**/*.cs;Models/**/*.cs" />
    <Compile Include="Audio/SimHubGameMonitor.cs" />
  </ItemGroup>
</Project>
