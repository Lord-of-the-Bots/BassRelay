<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BassRelay.Audio</AssemblyName>
    <RootNamespace>BassRelay</RootNamespace>
    <Version>1.4.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../BassRelay/Audio/*.cs" Exclude="../BassRelay/Audio/SimHubGameMonitor.cs" Link="Audio/%(Filename)%(Extension)" />
    <Compile Include="../BassRelay/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
